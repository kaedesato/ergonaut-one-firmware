#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

// Symbol keycodes for Windows with the OS layout set to Japanese.
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_BACKSLASH    0x87              // backslash, INT_RO position
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_YEN          0x89              // yen, INT_YEN position
#define JP_PIPE         LS(0x89)          // |

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        muhenkan {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <15 16>;
        };

        henkan {
            bindings = <&kp INT_HENKAN>;
            key-positions = <19 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            display-name = "Main";
            bindings = <
&kp ESCAPE  &kp Q  &kp L  &kp U                &kp MINUS  &kp JP_EQUAL  &kp F  &kp W          &kp R          &kp Y  &kp P  &kp DEL
&kp TAB     &kp E  &kp I  &kp A                &kp O      &kp DOT       &kp K  &kp T          &kp N          &kp S  &kp H  &kp ENTER
&kp LSHFT   &kp Z  &kp X  &kp C                &kp V      &kp COMMA     &kp G  &kp D          &kp M          &kp J  &kp B  &kp RSHFT
                          &mt LCTRL LC(SPACE)  &kp SPACE  &mo 1         &mo 2  &kp BACKSPACE  &kp RIGHT_ALT
            >;
        };

        Left {
            display-name = "Left";
            bindings = <
&trans  &kp DOLLAR   &kp JP_AT     &kp POUND  &kp JP_TILDE       &kp JP_BACKQUOTE  &trans        &kp N7        &kp N8   &kp N9  &trans        &trans
&trans  &kp PERCENT  &kp JP_CARET  &kp JP_AMPERSAND  &kp JP_ASTERISK    &kp FSLH          &kp JP_COLON  &kp N4        &kp N5   &kp N6  &kp EXCL      &kp LEFT_WIN
&trans  &trans       &trans        &trans     &trans              &kp JP_BACKSLASH   &kp SEMI      &kp N1        &kp N2   &kp N3  &kp QUESTION  &trans
                                             &kp JP_AT            &kp JP_UNDERSCORE  &trans        &trans     &kp NUMBER_0  &kp DOT
            >;
        };

        Right {
            display-name = "Right";
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &none   &kp JP_DQUOTE    &kp HOME        &kp UP        &kp END       &trans  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none   &kp JP_QUOTE     &kp LEFT        &kp DOWN      &kp RIGHT     &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &kp JP_LBRACKET  &kp JP_RBRACKET &kp JP_LPAREN &kp JP_RPAREN &trans  &trans
                         &trans   &trans   &trans  &trans           &kp JP_LBRACE   &kp JP_RBRACE
            >;
        };

        Config {
            display-name = "Conflg";
            bindings = <
&bootloader  &studio_unlock  &none         &none         &none         &none         &kp CAPS      &kp KP_NUMLOCK  &kp SCROLLLOCK  &none         &studio_unlock  &bootloader
&bt BT_CLR   &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3    &bt BT_SEL 2    &bt BT_SEL 1  &bt BT_SEL 0    &bt BT_CLR
&sys_reset   &none           &none         &none         &none         &none         &none         &none           &none           &none         &none           &sys_reset
                                           &trans        &none         &trans        &none         &trans          &trans
            >;
        };
    };
};
